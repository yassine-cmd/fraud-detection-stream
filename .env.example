# Copier ce fichier vers .env puis adapter les valeurs si besoin.
# Docker Compose lit automatiquement .env a la racine du projet.

# Retention MongoDB en secondes. 0 = aucune purge (retention infinie).
# Appliquee a transactions.scored_at et fraud_alerts.scored_at.
MONGO_TTL_SECONDS=86400

# Nombre de workers uvicorn pour le service api de la stack complete.
# 1 par coeur physique est un bon point de depart (SNF2 : P95 < 200 ms).
# Laisser vide ou 1 en mode mock pour conserver un etat simule coherent.
API_WORKERS=4
